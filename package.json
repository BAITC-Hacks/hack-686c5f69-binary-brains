{
  "name": "hackalem-ekt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:catalog": "tsc --project tsconfig.catalog.json",
    "test": "node --test tests/*.test.ts",
    "demo:catalog": "node scripts/catalog-demo.ts",
    "check:catalog-live": "node --env-file=.env.local scripts/catalog-live.ts",
    "start:catalog:demo": "node scripts/catalog-server.ts --demo",
    "start:catalog": "node --env-file=.env.local scripts/catalog-server.ts",
    "audit:catalog": "node --env-file=.env.local scripts/catalog-audit.ts",
    "check:alternative-live": "node --env-file=.env.local scripts/catalog-live-alternative.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
